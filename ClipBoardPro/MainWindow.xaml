<Window x:Class="JobFillHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:JobFillHelper.Models"
        Title="ClipBoard Pro"
        Icon="pack://siteoforigin:,,,/Assets/clipboard.ico"
        Width="390"
        MinWidth="340"
        Height="620"
        MinHeight="420"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="#16A34A" />
      <Setter Property="BorderBrush" Value="#15803D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="ToolTip" Value="Add field" />
    </Style>
    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Content" Value="&#xE74D;" />
      <Setter Property="ToolTip" Value="Delete" />
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#FCA5A5" />
      <Setter Property="Foreground" Value="#991B1B" />
    </Style>
    <Style x:Key="FieldActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Content" Value="&#xE70F;" />
      <Setter Property="ToolTip" Value="Edit" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEditing}" Value="True">
          <Setter Property="Content" Value="&#xE73E;" />
          <Setter Property="ToolTip" Value="Save" />
          <Setter Property="Background" Value="#DCFCE7" />
          <Setter Property="BorderBrush" Value="#86EFAC" />
          <Setter Property="Foreground" Value="#166534" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="10">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="{Binding StatusText}"
                 FontSize="12"
                 Foreground="#64748B"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0">
        <CheckBox Content="Top"
                  IsChecked="{Binding IsAlwaysOnTop}"
                  VerticalAlignment="Center" />
        <Button Content="+"
                Style="{StaticResource AddButton}"
                Margin="8,0,0,0"
                Click="AddField_Click" />
      </StackPanel>
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type models:FillField}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6"
                    Margin="0,0,0,6"
                    PreviewMouseLeftButtonDown="FieldCard_PreviewMouseLeftButtonDown">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         IsReadOnly="{Binding IsReadOnly}"
                         TextWrapping="Wrap"
                         MinHeight="34"
                         MaxHeight="72"
                         Foreground="#334155" />

                <Button Grid.Column="1"
                        Style="{StaticResource FieldActionButton}"
                        Click="ToggleEditField_Click" />
                <Button Grid.Column="2"
                        Style="{StaticResource DeleteButton}"
                        Click="DeleteField_Click" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>